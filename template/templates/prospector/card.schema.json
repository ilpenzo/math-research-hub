{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "cards", "verdicts"],
  "properties": {
    "summary": {"type": "string"},
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "kind", "statement", "role", "sketch", "weakest_step", "kill_test", "kill_script", "evidence", "differs_from", "confidence", "cost", "gap_after"],
        "properties": {
          "title": {"type": "string"},
          "kind": {"type": "string", "enum": ["lemma", "construction", "reduction", "counterexample", "strategy", "argument"]},
          "statement": {"type": "string"},
          "role": {"type": "string"},
          "sketch": {"type": "string"},
          "weakest_step": {"type": "string"},
          "kill_test": {"type": "string"},
          "kill_script": {"type": "object", "additionalProperties": false, "required": ["language", "source", "expected_if_true"], "properties": {"language": {"type": "string"}, "source": {"type": "string"}, "expected_if_true": {"type": "string"}}},
          "evidence": {"type": "string"},
          "differs_from": {"type": "string"},
          "confidence": {"type": "number"},
          "cost": {"type": "string", "enum": ["small", "medium", "large"]},
          "gap_after": {"type": "string"}
        }
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card", "verdict", "reason", "evidence", "salvage", "kill_script_result"],
        "properties": {
          "card": {"type": "string"},
          "verdict": {"type": "string", "enum": ["killed", "survives", "unclear"]},
          "reason": {"type": "string"},
          "evidence": {"type": "string"},
          "salvage": {"type": "string"},
          "kill_script_result": {"type": "object", "additionalProperties": false, "required": ["status", "output"], "properties": {"status": {"type": "string", "enum": ["passed", "failed", "error", "not-run", "none"]}, "output": {"type": "string"}}}
        }
      }
    }
  }
}
